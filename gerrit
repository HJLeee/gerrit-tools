#!/usr/bin/env python3
"""Gerrit Tools - search and clone Gerrit projects."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from pathlib import Path
import shutil
import subprocess
import sys
from typing import Callable, Sequence

DEFAULT_HOST = "review.tizen.org"
DEFAULT_PORT = "29418"
DEFAULT_WORKING_BRANCH = "origin/tizen"


@dataclass(frozen=True)
class Profile:
    """The fixed Gerrit endpoint and default branch used by this tool."""

    host: str = DEFAULT_HOST
    port: str = DEFAULT_PORT
    working_branch: str | None = DEFAULT_WORKING_BRANCH


class GerritClient:
    """Gerrit and Git process operations used by command handlers."""

    def __init__(self, profile: Profile | None = None) -> None:
        self.profile = profile or Profile()

    def list_projects(self) -> list[str]:
        result = subprocess.run(
            ["ssh", "-p", self.profile.port, self.profile.host, "gerrit", "ls-projects"],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        )
        return result.stdout.splitlines()

    def checkout_branch(self, destination: Path, working_branch: str) -> None:
        """Fetch one shallow branch into an existing clone and switch to it."""
        branch = working_branch.removeprefix("origin/")
        remote_ref = f"refs/heads/{branch}:refs/remotes/origin/{branch}"
        subprocess.run(["git", "fetch", "--depth", "1", "--no-tags", "origin", remote_ref],
                       check=True, cwd=destination)
        local_ref = f"refs/heads/{branch}"
        exists = subprocess.run(["git", "show-ref", "--verify", "--quiet", local_ref],
                                check=False, cwd=destination).returncode == 0
        if exists:
            subprocess.run(["git", "checkout", branch], check=True, cwd=destination)
            return

        subprocess.run(["git", "checkout", "-b", branch, f"origin/{branch}"],
                       check=True, cwd=destination)
        subprocess.run(["git", "config", f"branch.{branch}.remote", "origin"],
                       check=True, cwd=destination)
        subprocess.run(["git", "config", f"branch.{branch}.merge", f"refs/heads/{branch}"],
                       check=True, cwd=destination)

    def clone_project(self, project: str, target: str | None, branch: str | None = None) -> None:
        destination = target or Path(project).name
        destination_path = Path(destination)
        working_branch = branch if branch is not None else self.profile.working_branch
        if destination_path.exists():
            if not (destination_path / ".git").exists():
                raise ValueError(f"Destination exists but is not a Git repository: {destination}")
            if working_branch:
                self.checkout_branch(destination_path, working_branch)
            return

        command = ["git", "clone", "--depth", "1"]
        if working_branch:
            command.extend(["--branch", working_branch.removeprefix("origin/")])
        command.extend([f"ssh://{self.profile.host}:{self.profile.port}/{project}", destination])
        subprocess.run(command, check=True)

        try:
            subprocess.run(
                ["scp", "-O", "-p", "-P", self.profile.port,
                 f"{self.profile.host}:hooks/commit-msg", f"{destination}/.git/hooks/"],
                check=True,
            )
        except subprocess.CalledProcessError:
            print(f"Clone completed, but Gerrit setup failed in {destination}.", file=sys.stderr)
            raise


CommandHandler = Callable[[argparse.Namespace, GerritClient], int]


def render_projects(projects: list[str], title: str) -> None:
    """Use bat when interactive, without changing piped machine-readable output."""
    content = "\n".join(projects)
    if not sys.stdout.isatty():
        print(content)
        return

    bat = shutil.which("batcat") or shutil.which("bat")
    if bat:
        try:
            subprocess.run(
                [bat, "--paging=never", "--style=header,grid,numbers",
                 "--file-name", title, "--language=txt"],
                input=content + ("\n" if content else ""),
                text=True,
                check=True,
            )
            return
        except (OSError, subprocess.CalledProcessError):
            pass

    print(title)
    print("─" * len(title))
    if projects:
        for number, project in enumerate(projects, start=1):
            print(f"{number:>4}  {project}")
    else:
        print("No projects found.")


def command_list(args: argparse.Namespace, client: GerritClient) -> int:
    projects = client.list_projects()
    keyword = getattr(args, "keyword", None)
    if keyword:
        projects = [project for project in projects if keyword in project]
    title = "Gerrit projects" if not keyword else f"Gerrit projects matching: {keyword}"
    render_projects(projects, title)
    return 0


def command_source(args: argparse.Namespace, client: GerritClient) -> int:
    client.clone_project(args.path, args.target, args.branch)
    return 0


def add_command(
    subparsers: argparse._SubParsersAction[argparse.ArgumentParser],
    name: str,
    help_text: str,
    handler: CommandHandler,
    configure: Callable[[argparse.ArgumentParser], None] | None = None,
    aliases: tuple[str, ...] = (),
) -> None:
    """Register commands centrally; handlers and client methods stay independent."""
    command = subparsers.add_parser(name, help=help_text, aliases=list(aliases))
    if configure:
        configure(command)
    command.set_defaults(handler=handler)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    add_command(subparsers, "ls", "show all projects", command_list)

    def search_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("keyword", help="case-sensitive project name fragment")
    add_command(subparsers, "search", "search projects", command_list, search_options)

    def source_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("path", help="Gerrit project path")
        command.add_argument("target", nargs="?", help="clone destination")
        command.add_argument("-b", "--branch", help="branch to shallow-clone")
    add_command(subparsers, "src", "clone a project and install its Gerrit hook",
                command_source, source_options, aliases=("clone",))
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args, GerritClient())
    except (subprocess.CalledProcessError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
