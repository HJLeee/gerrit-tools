#!/usr/bin/env python3
"""Gerrit Tools - search and clone Gerrit projects."""

from __future__ import annotations

import argparse
import configparser
from dataclasses import dataclass
from pathlib import Path
import subprocess
import shutil
import sys
from typing import Callable, Sequence

CONFIG_PATH = Path.home() / ".gerrit.ini"
DEFAULT_HOST = "review.tizen.org"
DEFAULT_PORT = "29418"
DEFAULT_WORKING_BRANCH = "origin/tizen"


@dataclass(frozen=True)
class Profile:
    host: str = DEFAULT_HOST
    port: str = DEFAULT_PORT
    user: str | None = None
    working_branch: str | None = DEFAULT_WORKING_BRANCH


class ConfigurationError(Exception):
    pass


class ConfigStore:
    """Load optional per-profile overrides for the built-in Gerrit endpoint."""

    def __init__(self, path: Path = CONFIG_PATH) -> None:
        self.path = path

    def get_profile(self, requested: str | None) -> Profile:
        if not self.path.exists():
            if requested:
                raise ConfigurationError(f"Profile [{requested}] was not found: {self.path} does not exist")
            return Profile()

        config = configparser.ConfigParser()
        config.read(self.path)
        if not config.sections():
            raise ConfigurationError(f"No profiles found in {self.path}")
        name = self._select_profile(config, requested)
        section = config[name]
        host = self._value(section, "host", DEFAULT_HOST)
        port = self._value(section, "port", DEFAULT_PORT)
        user = self._value(section, "user", None)
        branch = self._value(section, "working_branch", DEFAULT_WORKING_BRANCH)
        if not host:
            raise ConfigurationError(f"Profile [{name}] has an empty host")
        if not port.isdecimal() or not 0 < int(port) < 65536:
            raise ConfigurationError(f"Profile [{name}] has an invalid port: {port!r}")
        return Profile(host, port, user or None, branch or None)

    @staticmethod
    def _value(section: configparser.SectionProxy, key: str, fallback: str | None) -> str | None:
        return section[key].strip() if key in section else fallback

    def _select_profile(self, config: configparser.ConfigParser, requested: str | None) -> str:
        if requested:
            if requested not in config:
                raise ConfigurationError(f"Profile [{requested}] was not found in {self.path}")
            return requested
        profiles = config.sections()
        if len(profiles) == 1:
            return profiles[0]
        raise ConfigurationError(
            f"Multiple profiles found; use --profile. Available: {', '.join(profiles)}"
        )


class GerritClient:
    """Gerrit and Git process operations used by command handlers."""

    def __init__(self, profile: Profile) -> None:
        self.profile = profile

    def list_projects(self) -> list[str]:
        command = ["ssh", "-p", self.profile.port]
        if self.profile.user:
            command.extend(["-l", self.profile.user])
        command.extend([self.profile.host, "gerrit", "ls-projects"])
        result = subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE)
        return result.stdout.splitlines()

    def clone_project(self, project: str, target: str | None, branch: str | None = None) -> None:
        destination = target or Path(project).name
        authority = f"{self.profile.user}@" if self.profile.user else ""
        url = f"ssh://{authority}{self.profile.host}:{self.profile.port}/{project}"
        clone = ["git", "clone", "--depth", "1"]
        working_branch = branch if branch is not None else self.profile.working_branch
        if working_branch:
            clone.extend(["--branch", working_branch.removeprefix("origin/")])
        clone.extend([url, destination])
        subprocess.run(clone, check=True)
        try:
            hook_host = f"{authority}{self.profile.host}"
            subprocess.run(["scp", "-O", "-p", "-P", self.profile.port,
                            f"{hook_host}:hooks/commit-msg", f"{destination}/.git/hooks/"], check=True)
        except subprocess.CalledProcessError:
            print(f"Clone completed, but Gerrit setup failed in {destination}.", file=sys.stderr)
            raise


CommandHandler = Callable[[argparse.Namespace, GerritClient], int]


def render_projects(projects: list[str], title: str) -> None:
    """Use bat when interactive, without changing piped machine-readable output."""
    content = "\n".join(projects)
    if not sys.stdout.isatty():
        print(content)
        return

    bat = shutil.which("batcat") or shutil.which("bat")
    if bat:
        try:
            subprocess.run(
                [bat, "--paging=never", "--style=header,grid,numbers",
                 "--file-name", title, "--language=txt"],
                input=content + ("\n" if content else ""), text=True, check=True,
            )
            return
        except (OSError, subprocess.CalledProcessError):
            pass

    print(title)
    print("─" * len(title))
    if projects:
        for number, project in enumerate(projects, start=1):
            print(f"{number:>4}  {project}")
    else:
        print("No projects found.")


def command_list(args: argparse.Namespace, client: GerritClient) -> int:
    projects = client.list_projects()
    keyword = getattr(args, "keyword", None)
    if keyword:
        projects = [project for project in projects if keyword in project]
    title = "Gerrit projects" if not keyword else f"Gerrit projects matching: {keyword}"
    render_projects(projects, title)
    return 0


def command_source(args: argparse.Namespace, client: GerritClient) -> int:
    client.clone_project(args.path, args.target, args.branch)
    return 0


def add_command(subparsers: argparse._SubParsersAction[argparse.ArgumentParser],
                name: str, help_text: str, handler: CommandHandler,
                configure: Callable[[argparse.ArgumentParser], None] | None = None,
                aliases: tuple[str, ...] = ()) -> None:
    """Register commands centrally; handlers and client methods stay independent."""
    command = subparsers.add_parser(name, help=help_text, aliases=list(aliases))
    if configure:
        configure(command)
    command.set_defaults(handler=handler)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-p", "-P", "--profile", help="optional profile in ~/.gerrit.ini")
    subparsers = parser.add_subparsers(dest="command", required=True)
    add_command(subparsers, "ls", "show all projects", command_list)

    def search_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("keyword", help="case-sensitive project name fragment")
    add_command(subparsers, "search", "search projects", command_list, search_options)

    def source_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("path", help="Gerrit project path")
        command.add_argument("target", nargs="?", help="clone destination")
        command.add_argument("-b", "--branch", help="branch to shallow-clone; overrides the profile")
    add_command(subparsers, "src", "clone a project and install its Gerrit hook",
                command_source, source_options, aliases=("clone",))
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args, GerritClient(ConfigStore().get_profile(args.profile)))
    except (ConfigurationError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
